{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Living Environment Explorer",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-g",
                "-std=c++17",
                "${workspaceFolder}\\LivingEnvironmentExplorer.cpp",
                "-o",
                "${workspaceFolder}\\LivingEnvironmentExplorer.exe",
                "-lfreeglut",
                "-lopengl32",
                "-lglu32"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
